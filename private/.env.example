# 这是模板文件，不要把真实密钥写在这里。
# 复制一份改名为 .env 再填，.env 已在 .gitignore 里。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
APP_TIMEZONE=Asia/Shanghai

# Optional safety/psychology persistence (unset = local files, no MySQL required).
# Create an empty database and grant access before enabling.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# SESSION_SECRET=
# Optional safety AI (independent of Dreamtrace Qwen configuration):
# HEALTH_AI_API_KEY=
# HEALTH_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HEALTH_AI_MODEL=qwen-plus
